# Copy to .env and fill in what you have. Every channel runs as a dry run until its keys are set.
PORT=8787
API_KEY=change-me                # required for write endpoints when set
CORS_ORIGIN=*
WEBHOOK_SECRET=change-me         # signs outgoing webhooks (X-Prospect-Signature)
DATA_FILE=./data/prospect.json   # empty = memory only
SIMULATE=true                    # demo traffic; defaults to true when no Google key is set
SIMULATE_RATE=30
SEQUENCE_DAY_MS=86400000         # set to 5000 to watch a 10-day sequence in under a minute
RATE_LIMIT_PER_MIN=600

GOOGLE_MAPS_API_KEY=
SENDGRID_API_KEY=
FROM_EMAIL=
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
META_PIXEL_ID=
META_ACCESS_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TOKEN=
LOB_API_KEY=
HUBSPOT_TOKEN=
SLACK_WEBHOOK_URL=
